pipeline {
    agent { label 'ci' }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'eu-central-1'
        AWS_ACCOUNT_ID = '366183011726'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPOSITORY = 'task-management-api-dev'
        APP_DIR = '18.Jenkins/task-management-api'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh 'npm ci'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${APP_DIR}") {
                    sh 'npm test'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        docker build \
                          -t "$ECR_REGISTRY/$ECR_REPOSITORY:$GIT_COMMIT" \
                          .
                    '''
                }
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password \
                      --region "$AWS_REGION" \
                    | docker login \
                      --username AWS \
                      --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Push Image') {
            steps {
                sh '''
                    docker push \
                      "$ECR_REGISTRY/$ECR_REPOSITORY:$GIT_COMMIT"
                '''
            }
        }
    }

    post {
        success {
            echo "Build and ECR push completed successfully."
            echo "Image: ${ECR_REGISTRY}/${ECR_REPOSITORY}:${GIT_COMMIT}"
        }

        always {
            sh '''
                docker image prune -f || true
            '''
        }
    }
}