server {

    listen {% if item is defined %}{{ 8080 + item }}{% else %}{{ http_port }}{% endif %};

    server_name {{ server_name }};

    root {{ web_root }};

    index index.html;

    access_log {{ access_log }};

    error_log {{ error_log }};

    location / {

        auth_basic "Restricted Area";
        auth_basic_user_file /etc/nginx/.htpasswd;

        try_files $uri $uri/ =404;

    }

}
